# Docker Container Versions
HEMS_VERSION=0.11.8
BEMS_VERSION=0.11.8
MOSQUITTO_VERSION=2.0
INFLUXDB_VERSION=2.9.1
GRAFANA_VERSION=13.2

# ============================================================
# InfluxDB initialization — used only on first initialization
# ============================================================
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME
DOCKER_INFLUXDB_INIT_ORG=home-energy
DOCKER_INFLUXDB_INIT_BUCKET=energy

# ============================================================
# HEMS Home Energy Monitoring/Management System
# ============================================================
INFLUXDB_TOKEN=CHANGE_ME
MQTT_HEMS_PASSWORD=energy-monitoring-hems


# ============================================================
# BEMS - Battery Energy Management System
# ============================================================
MQTT_BEMS_PASSWORD=energy-monitoring-bems

# ============================================================
# Grafana
# ============================================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=energy-monitoring-dev  #<strong-grafana-password>
GRAFANA_INFLUXDB_TOKEN=<grafana-read-token>
